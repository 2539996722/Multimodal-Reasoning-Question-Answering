# OCR and VLM are independent OpenAI-compatible Chat Completions endpoints.
OCR_BASE_URL=https://your-ocr-service.example.com
OCR_API_KEY=
OCR_MODEL=your-ocr-model
OCR_TIMEOUT_SECONDS=120

VLM_BASE_URL=https://your-vlm-service.example.com
VLM_API_KEY=
VLM_MODEL=your-vlm-model
VLM_TIMEOUT_SECONDS=120
VLM_TEMPERATURE=0

# Semi-final RAG. Dedicated /embeddings and /rerank endpoints are preferred;
# unsupported providers automatically fall back to structured Chat Completions scoring.
RETRIEVAL_BASE_URL=https://api.siliconflow.cn/v1
RETRIEVAL_API_KEY=
RETRIEVAL_MODEL=your-embedding-or-chat-model
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_MODEL=your-rerank-or-chat-model

# Keep enabled for an offline, clearly labeled reference-replay demo.
DEMO_MODE=true
MODEL_TIMEOUT_SECONDS=120

# Optional OpenAI image detail hint (low|default|high). Many OpenAI-compatible
# gateways reject this field, so it is omitted unless explicitly set.
# MODEL_IMAGE_DETAIL=high
